# 复制为 .env 并填写
# ---------------------------------------
# 1) 网关：Relay 走 /v1，Admin API 走根路径
#    例：网关域名 https://gw.example.com，走 /v1，admin API https://gw.example.com/api
GATEWAY_BASE_URL=https://gw.example.com/v1
NEWAPI_ADMIN_BASE_URL=https://gw.example.com

# 2) 管理端鉴权：admin 账户的 access token（个人访问令牌 PAT）
#    在管理后台「个人设置 → access token」获取，需是管理员角色
NEWAPI_ADMIN_ACCESS_TOKEN=sk-xxxxxxxxxxxxx

# 3) 检测路由 token：同样是 admin 账户下的一个 API token，填其原始 key（不含 sk- 前缀）
#    调度器会拼成  sk-<此key>-<渠道ID>  做渠道硬固定
#    该 token 建议：无限配额 / 不限制模型，避免检测到一半被计费或模型限制挡住
DETECTOR_API_KEY=abcdefgh...

# 4) 检测模式：juice（仅型号指纹，无需可信端，推荐）| full（完整 COT+Juice）
DETECT_MODE=juice

# 5) full 模式需要可信的真实 GPT-5.6 端（juice 模式忽略）
# TRUSTED_BASE_URL=https://boost.gw.example.com/v1
# TRUSTED_MODEL=gpt-5.6-sol
# TRUSTED_API_KEY=sk-xxxx

# 6) 模型选择：从每个渠道 Models 里匹配该正则；匹配不到则回退 FALLBACK_MODEL
MODEL_PATTERN=gpt-5\.6
FALLBACK_MODEL=gpt-5.6-sol

# 7) 调度与报告
DETECT_INTERVAL_MINUTES=60
REPORT_PUBLIC_PORT=8080
# DETECT_WORKERS=1
# DETECT_TIMEOUT=180
# 正式服可能在 Cloudflare 后面，需用浏览器 UA 才不被拦
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
GPT56_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
# 渠道间并发数：并行检测的渠道个数（每个渠道内部请求数由 DETECT_WORKERS 控制）
# 调大可提速，但会增加对正式服的并发请求，可能触发限流/渠道 auto-ban，建议 1~3
DETECT_CONCURRENCY=1
